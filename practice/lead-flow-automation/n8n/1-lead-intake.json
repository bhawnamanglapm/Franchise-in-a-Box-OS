              "id": "31e91777-8070-4f61-962d-0b47742d69a8",
              "leftValue": "={{ !!$json.existingId }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
